#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" -e BUILD_DIR -e SANITIZE bash "$0" "$@"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# A dedicated build dir configured with --fresh: the checked-in-era `build/` caches point at an old
# libwebsockets/OpenSSL layout and fail to configure (AUDIT section 5). Override with BUILD_DIR=...
# SANITIZE=1 builds with AddressSanitizer + UBSan.
BUILD_DIR="${BUILD_DIR:-$ROOT/build-test}"
SANITIZE="${SANITIZE:-0}"
TS_ROOT="$(cd "$ROOT/../channel" && pwd)"
TS_SERVER="$TS_ROOT/tests/server.ts"
TS_PID=""

cleanup() {
  if [[ -n "${TS_PID}" ]] && kill -0 "${TS_PID}" 2>/dev/null; then
    kill "${TS_PID}" >/dev/null 2>&1 || true
    wait "${TS_PID}" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

mkdir -p "$ROOT/coverage"

cmake --fresh -S "$ROOT" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Debug -DCHANNEL_C_SANITIZE="$([[ "$SANITIZE" == 1 ]] && echo ON || echo OFF)"
cmake --build "$BUILD_DIR" -j8

if nc -z 127.0.0.1 2049 >/dev/null 2>&1; then
  echo "Using existing fixture server on 127.0.0.1:2049"
else
  pushd "$TS_ROOT" >/dev/null
  bun "$TS_SERVER" > "$ROOT/coverage/ts-server.log" 2>&1 &
  TS_PID=$!
  popd >/dev/null
fi

for _ in $(seq 1 200); do
  if nc -z 127.0.0.1 2049 >/dev/null 2>&1; then
    break
  fi
  sleep 0.05
done

if ! nc -z 127.0.0.1 2049 >/dev/null 2>&1; then
  echo "failed to start TypeScript fixture server on 127.0.0.1:2049" >&2
  tail -n 200 "$ROOT/coverage/ts-server.log" >&2 || true
  exit 1
fi

cd "$BUILD_DIR"
ctest --output-on-failure
